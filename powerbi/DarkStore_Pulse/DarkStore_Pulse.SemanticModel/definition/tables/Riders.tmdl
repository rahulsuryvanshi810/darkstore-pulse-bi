table 'Riders'
	lineageTag: edcd465e-3638-4821-b6e0-7cc06c52c49f

	column 'rider_id'
		dataType: string
		isHidden
		lineageTag: b09b2a5c-badc-432a-8159-0f538a0f4efb
		summarizeBy: none
		sourceColumn: rider_id

	column 'store_id'
		dataType: string
		isHidden
		lineageTag: 66245bfa-4fcc-439a-b683-d2e6337ea2df
		summarizeBy: none
		sourceColumn: store_id

	column 'vehicle_type'
		dataType: string
		lineageTag: 5f987c71-a65e-488e-abf3-ad39fec21bbe
		summarizeBy: none
		sourceColumn: vehicle_type

	column 'join_date'
		dataType: dateTime
		formatString: d mmm yyyy
		lineageTag: 7394988f-847f-49b4-a64d-1bcb702753a1
		summarizeBy: none
		sourceColumn: join_date

	partition 'Riders' = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "riders.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"rider_id", type text}, {"store_id", type text}, {"vehicle_type", type text},
				        {"join_date", type date}}, "en-IN")
				in
				    Typed

	annotation PBI_ResultType = Table

