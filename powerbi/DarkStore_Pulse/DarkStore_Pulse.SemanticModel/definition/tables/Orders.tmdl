	column order_hour
		dataType: int64
		formatString: 0
		lineageTag: 1c88fc59-4e60-4961-aa3b-2cbd22ae3659
		summarizeBy: sum
		sourceColumn: order_hour

		annotation SummarizationSetBy = Automatic

	column 'Hour Band' =
			SWITCH (
				TRUE (),
				Orders[order_hour] < 10, "1 Morning (6-10)",
				Orders[order_hour] < 17, "2 Daytime (10-17)",
				Orders[order_hour] < 23, "3 Evening rush (17-23)",
				"4 Late night (23+)"
			)
		dataType: string
		lineageTag: 9d186647-fcad-45ac-bf31-be696fa36f38
		summarizeBy: none

	column 'Delay Band' =
			SWITCH (
				TRUE (),
				ISBLANK ( Orders[delivery_minutes] ), "Cancelled",
				Orders[delivery_minutes] <= 10, "1 On time (<=10)",
				Orders[delivery_minutes] <= 12, "2 10-12 min",
				Orders[delivery_minutes] <= 15, "3 12-15 min",
				Orders[delivery_minutes] <= 20, "4 15-20 min",
				"5 20+ min"
			)
		dataType: string
		lineageTag: e7e860f2-cb9c-4aed-b67b-89916778d728
		summarizeBy: none

	column Weather = IF ( Orders[is_rain_day] = 1, "Rain day", "Dry day" )
		dataType: string
		lineageTag: d6bdd1c5-fbf9-4270-8faa-d6b61502ff06
		summarizeBy: none

	column 'Months Since Signup' = DATEDIFF ( RELATED ( Customers[Cohort Month] ), Orders[order_date], MONTH )
		dataType: int64
		formatString: 0
		lineageTag: e6ab3a49-a46a-49c0-82a3-daf74e146a40
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Orders = m
		mode: import
		source =
				let
				    Source   = Csv.Document(File.Contents(DataFolder & "orders.csv"),
				                 [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers  = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // cancelled orders have blank minutes / rating / sla_met / reason -> null
				    Blanks   = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue,
				                 {"delivery_minutes", "rating", "sla_met", "cancel_reason"}),
				    Typed    = Table.TransformColumnTypes(Blanks, {
				        {"order_id", type text}, {"order_datetime", type datetime}, {"store_id", type text},
				        {"customer_id", type text}, {"rider_id", type text}, {"status", type text},
				        {"cancel_reason", type text}, {"payment_method", type text},
				        {"is_first_order", Int64.Type}, {"coupon_used", Int64.Type}, {"is_rain_day", Int64.Type},
				        {"festival", type text}, {"items_count", Int64.Type},
				        {"item_total", Currency.Type}, {"discount", Currency.Type}, {"delivery_fee", Currency.Type},
				        {"cogs", Currency.Type}, {"rider_cost", Currency.Type}, {"distance_km", type number},
				        {"delivery_minutes", type number}, {"rating", Int64.Type}, {"had_stockout", Int64.Type},
				        {"sla_met", Int64.Type}, {"net_revenue", Currency.Type}, {"contribution", Currency.Type}},
				        "en-IN"),
				    AddDate  = Table.AddColumn(Typed, "order_date", each DateTime.Date([order_datetime]), type date),
				    AddHour  = Table.AddColumn(AddDate, "order_hour", each Time.Hour([order_datetime]), Int64.Type)
				in
				    AddHour

	annotation PBI_ResultType = Table

