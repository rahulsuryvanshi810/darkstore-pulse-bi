table 'Stores'
	lineageTag: 988c24c9-61b1-4d22-a280-1c4510435a10

	column 'store_id'
		dataType: string
		isHidden
		lineageTag: 405cacec-8774-49a9-b7d2-1e02ff01cf99
		summarizeBy: none
		sourceColumn: store_id

	column 'store_name'
		dataType: string
		lineageTag: f143262f-dc5c-4eed-8da0-365bf89897b9
		summarizeBy: none
		sourceColumn: store_name

	column 'zone'
		dataType: string
		lineageTag: 1d53434b-b881-49b9-ae27-0da702f06b90
		summarizeBy: none
		sourceColumn: zone

	column 'latitude'
		dataType: double
		lineageTag: c0398710-8976-4334-a281-7efdae849217
		dataCategory: Latitude
		summarizeBy: none
		sourceColumn: latitude

	column 'longitude'
		dataType: double
		lineageTag: 5715bd6f-a416-4293-84c2-e2e3444ea7c8
		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: longitude

	column 'open_date'
		dataType: dateTime
		formatString: d mmm yyyy
		lineageTag: 287d06ca-6f4c-469a-8b22-d3081c8eaee9
		summarizeBy: none
		sourceColumn: open_date

	column 'riders'
		dataType: int64
		formatString: 0
		lineageTag: b8db0672-f42d-47cc-80d4-af5974273ca3
		summarizeBy: none
		sourceColumn: riders

	column 'city'
		dataType: string
		lineageTag: f8cda88b-436d-46e2-b83c-fe0be037e5ed
		dataCategory: City
		summarizeBy: none
		sourceColumn: city

	column 'sla_minutes'
		dataType: int64
		formatString: 0
		lineageTag: 81f76d1c-2dbc-4134-830f-f46e8026695f
		summarizeBy: none
		sourceColumn: sla_minutes

	column 'location'
		dataType: string
		lineageTag: a013ac6e-deda-4e16-9b3d-bd5ce9a1fa6f
		dataCategory: Place
		summarizeBy: none
		sourceColumn: location

	partition 'Stores' = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "stores.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"store_id", type text}, {"store_name", type text}, {"zone", type text},
				        {"latitude", type number}, {"longitude", type number}, {"open_date", type date},
				        {"riders", Int64.Type}, {"city", type text}, {"sla_minutes", Int64.Type}}, "en-IN"),
				    // "Kothrud, Pune" geocodes reliably in the map visual
				    AddLoc  = Table.AddColumn(Typed, "location", each [store_name] & ", Pune, India", type text)
				in
				    AddLoc

	annotation PBI_ResultType = Table

