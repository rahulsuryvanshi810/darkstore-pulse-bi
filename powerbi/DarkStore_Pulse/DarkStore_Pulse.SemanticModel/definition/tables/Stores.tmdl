	column open_date
		dataType: dateTime
		formatString: d mmm yyyy
		lineageTag: 8e6a9afa-1cd2-4f22-ab92-43a60f7942e2
		summarizeBy: none
		sourceColumn: open_date

		variation Variation
			isDefault
			relationship: ab8858ef-0213-4315-afcb-f28b0f7c3bac
			defaultHierarchy: LocalDateTable_e5411570-6ed4-41f4-beed-1d55b4faa84a.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column riders
		dataType: int64
		formatString: 0
		lineageTag: bcccb791-1952-4a26-96eb-8d2b10247c87
		summarizeBy: sum
