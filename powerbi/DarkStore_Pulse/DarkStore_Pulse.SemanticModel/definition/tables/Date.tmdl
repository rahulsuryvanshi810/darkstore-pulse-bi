table Date
	dataCategory: Time
	lineageTag: 1064005c-3985-43cf-bf76-be1d1efa2197

	column 'Date'
		dataType: dateTime
		formatString: d mmm yyyy
		isKey
		lineageTag: 8dcdcd03-969b-4662-8562-8059568cc69b
		summarizeBy: none
		sourceColumn: [Date]

	column 'Year'
		dataType: int64
		formatString: 0
		lineageTag: 01d74256-3860-4ab6-96a4-02f23ae8cc93
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: 0f1259e0-a18f-46b6-b535-106e122c9a56
		summarizeBy: none
		sourceColumn: [Month No]

	column 'Month'
		dataType: string
		lineageTag: 080aadfb-e7c9-4b26-9141-25c63a9bedd4
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month Start'

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 839fbc50-1223-4513-9496-f63cdc1110c1
		summarizeBy: none
		sourceColumn: [Month Start]

	column 'Week Start'
		dataType: dateTime
		formatString: d mmm yyyy
		lineageTag: 7c441fe7-ab42-40a7-874a-493b3ceddf2d
		summarizeBy: none
		sourceColumn: [Week Start]

	column 'Weekday'
		dataType: string
		lineageTag: b92da22b-21df-406f-8a0b-3c3336d8393a
		summarizeBy: none
		sourceColumn: [Weekday]
		sortByColumn: 'Weekday No'

	column 'Weekday No'
		dataType: int64
		formatString: 0
		lineageTag: 93829b43-922f-415a-a1e3-db63ef7ddc76
		summarizeBy: none
		sourceColumn: [Weekday No]

	column 'Is Weekend'
		dataType: string
		lineageTag: 7914c120-c8dc-419f-be35-11287900f7f9
		summarizeBy: none
		sourceColumn: [Is Weekend]

	partition Date = calculated
		mode: import
		source =
				VAR _start = DATE ( 2025, 10, 1 )
				VAR _end = DATE ( 2026, 9, 30 )
				RETURN
					ADDCOLUMNS (
						CALENDAR ( _start, _end ),
						"Year", YEAR ( [Date] ),
						"Month No", MONTH ( [Date] ),
						"Month", FORMAT ( [Date], "MMM yyyy" ),
						"Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
						"Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1,
						"Weekday", FORMAT ( [Date], "ddd" ),
						"Weekday No", WEEKDAY ( [Date], 2 ),
						"Is Weekend", IF ( WEEKDAY ( [Date], 2 ) >= 6, "Weekend", "Weekday" )
					)

