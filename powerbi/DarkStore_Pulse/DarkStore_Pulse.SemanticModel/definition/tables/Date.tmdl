table Date
	dataCategory: Time
	lineageTag: bdab0fb3-066f-4eaa-aae2-ba783e9df653

	column 'Date'
		dataType: dateTime
		formatString: d mmm yyyy
		isKey
		lineageTag: 98e63a65-de45-402a-814f-49070a83f2bb
		summarizeBy: none
		sourceColumn: [Date]

	column 'Year'
		dataType: int64
		formatString: 0
		lineageTag: 2310f19a-8bc1-4c71-a6bb-f197c0372f32
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: 400a61d1-566c-48f3-83a1-7b4e40306f4b
		summarizeBy: none
		sourceColumn: [Month No]

	column 'Month'
		dataType: string
		lineageTag: 9cd6f615-5843-482d-975e-f5214aba9725
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month Start'

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 0e5ca9e0-e666-4877-8f19-34c953f02523
		summarizeBy: none
		sourceColumn: [Month Start]

	column 'Week Start'
		dataType: dateTime
		formatString: d mmm yyyy
		lineageTag: e35353c9-de4f-4556-9759-8924fe2c2344
		summarizeBy: none
		sourceColumn: [Week Start]

	column 'Weekday'
		dataType: string
		lineageTag: ae3716d3-cfdf-4bca-ae89-2230c48f77fa
		summarizeBy: none
		sourceColumn: [Weekday]
		sortByColumn: 'Weekday No'

	column 'Weekday No'
		dataType: int64
		formatString: 0
		lineageTag: ef20a918-f6b8-456e-bc1b-3bbb10ac2f3f
		summarizeBy: none
		sourceColumn: [Weekday No]

	column 'Is Weekend'
		dataType: string
		lineageTag: 687aa0c3-9cb8-494e-b109-d97c532342f5
		summarizeBy: none
		sourceColumn: [Is Weekend]

	partition Date = calculated
		mode: import
		source =
				VAR _start = DATE ( 2025, 10, 1 )
				VAR _end = DATE ( 2026, 9, 30 )
				RETURN
					ADDCOLUMNS (
						CALENDAR ( _start, _end ),
						"Year", YEAR ( [Date] ),
						"Month No", MONTH ( [Date] ),
						"Month", FORMAT ( [Date], "MMM yyyy" ),
						"Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
						"Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1,
						"Weekday", FORMAT ( [Date], "ddd" ),
						"Weekday No", WEEKDAY ( [Date], 2 ),
						"Is Weekend", IF ( WEEKDAY ( [Date], 2 ) >= 6, "Weekend", "Weekday" )
					)

