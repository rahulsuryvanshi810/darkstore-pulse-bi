table Date
	lineageTag: aa20e007-2374-43b6-8259-031294ca5c55
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: d mmm yyyy
		lineageTag: 05af7cdc-1571-4cec-bfc9-15768723482b
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 1386a634-3fd3-46d6-8eed-06e56f370349
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month No'
		dataType: int64
		formatString: 0
		lineageTag: 0065c9aa-d2f1-4eca-b5bf-4df101fdaf81
		summarizeBy: none
		sourceColumn: [Month No]

	column Month
		dataType: string
		lineageTag: 6b15445b-351e-4bc1-bb3e-f87b73bfb6dd
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month Start'

	column 'Month Start'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: e699e11d-2278-4bb7-aa60-4477bbac640c
		summarizeBy: none
		sourceColumn: [Month Start]

	column 'Week Start'
		dataType: dateTime
		formatString: d mmm yyyy
		lineageTag: a6b08140-8bf8-48db-9c0b-75a02da9ef87
		summarizeBy: none
		sourceColumn: [Week Start]

	column Weekday
		dataType: string
		lineageTag: 9d58f289-8249-41d7-ba20-0e98817628b4
		summarizeBy: none
		sourceColumn: [Weekday]
		sortByColumn: 'Weekday No'

	column 'Weekday No'
		dataType: int64
		formatString: 0
		lineageTag: 779f7dc7-ccb8-40cd-9d86-46db2d267fd8
		summarizeBy: none
		sourceColumn: [Weekday No]

	column 'Is Weekend'
		dataType: string
		lineageTag: 8e6e6ee5-8c8a-4003-9fcc-d63c8d4eeecb
		summarizeBy: none
		sourceColumn: [Is Weekend]

	partition Date = calculated
		mode: import
		source =
				VAR _start = DATE ( 2025, 10, 1 )
				VAR _end = DATE ( 2026, 9, 30 )
				RETURN
					ADDCOLUMNS (
						CALENDAR ( _start, _end ),
						"Year", YEAR ( [Date] ),
						"Month No", MONTH ( [Date] ),
						"Month", FORMAT ( [Date], "MMM yyyy" ),
						"Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
						"Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1,
						"Weekday", FORMAT ( [Date], "ddd" ),
						"Weekday No", WEEKDAY ( [Date], 2 ),
						"Is Weekend", IF ( WEEKDAY ( [Date], 2 ) >= 6, "Weekend", "Weekday" )
					)

