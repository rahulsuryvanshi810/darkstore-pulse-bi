table 'Order Items'
	lineageTag: 351f2b0e-707b-432a-915f-f2d45a0fb9c7

	column order_id
		dataType: string
		isHidden
		lineageTag: ca65d737-2e98-403e-a2c0-b2e5ba6f9d76
		summarizeBy: none
		sourceColumn: order_id

	column product_id
		dataType: string
		isHidden
		lineageTag: 404600e0-02c5-4fc9-8463-e23d9dfe7907
		summarizeBy: none
		sourceColumn: product_id

	column quantity
		dataType: int64
		formatString: 0
		lineageTag: bb14b9e9-52c9-4e3d-b71c-3515a982a896
		summarizeBy: none
		sourceColumn: quantity

	column mrp
		dataType: decimal
		formatString: ₹#,0.00
		lineageTag: 1d38b78c-bbc9-41b9-be0d-79609ab28ad4
		summarizeBy: sum
		sourceColumn: mrp

	column unit_cost
		dataType: decimal
		formatString: ₹#,0.00
		lineageTag: dcd43490-5394-4252-a84f-cf726ad83bfa
		summarizeBy: sum
		sourceColumn: unit_cost

	column fulfilled
		dataType: int64
		formatString: 0
		lineageTag: da34d7df-1772-4631-a487-bd3ac9a34392
		summarizeBy: none
		sourceColumn: fulfilled

	partition 'Order Items' = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "order_items.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"order_id", type text}, {"product_id", type text}, {"quantity", Int64.Type},
				        {"mrp", Currency.Type}, {"unit_cost", Currency.Type}, {"fulfilled", Int64.Type}}, "en-IN")
				in
				    Typed

	annotation PBI_ResultType = Table

