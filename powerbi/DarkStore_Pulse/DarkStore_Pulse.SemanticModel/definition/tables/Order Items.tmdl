table 'Order Items'
	lineageTag: bf3c4c06-4343-48bc-89fa-6a688fb5d27b

	column 'order_id'
		dataType: string
		isHidden
		lineageTag: 956269f0-e5d7-4875-adad-d6c795a76d79
		summarizeBy: none
		sourceColumn: order_id

	column 'product_id'
		dataType: string
		isHidden
		lineageTag: ff50bde4-3825-47b8-9cab-cc97663f1c97
		summarizeBy: none
		sourceColumn: product_id

	column 'quantity'
		dataType: int64
		formatString: 0
		lineageTag: 7e570ddf-8270-40a8-a369-b584ff5e9ff0
		summarizeBy: none
		sourceColumn: quantity

	column 'mrp'
		dataType: decimal
		formatString: ₹#,0.00
		lineageTag: dc713d96-0c0f-4195-817a-f08a1745d6d8
		summarizeBy: sum
		sourceColumn: mrp

	column 'unit_cost'
		dataType: decimal
		formatString: ₹#,0.00
		lineageTag: 28f49481-a0a0-4dc4-a720-9bdf1c11f735
		summarizeBy: sum
		sourceColumn: unit_cost

	column 'fulfilled'
		dataType: int64
		formatString: 0
		lineageTag: 98ae4334-6c12-4ce8-ae34-0454cac5b68c
		summarizeBy: none
		sourceColumn: fulfilled

	partition 'Order Items' = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "order_items.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"order_id", type text}, {"product_id", type text}, {"quantity", Int64.Type},
				        {"mrp", Currency.Type}, {"unit_cost", Currency.Type}, {"fulfilled", Int64.Type}}, "en-IN")
				in
				    Typed

	annotation PBI_ResultType = Table

