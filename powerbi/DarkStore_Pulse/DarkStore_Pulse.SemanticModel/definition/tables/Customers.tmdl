table 'Customers'
	lineageTag: 14296c07-f26b-4776-913e-4de2e0c53cb8

	column 'customer_id'
		dataType: string
		isHidden
		lineageTag: d0e6e660-7c69-4ee1-bb5e-4bcf15ed6269
		summarizeBy: none
		sourceColumn: customer_id

	column 'home_store_id'
		dataType: string
		isHidden
		lineageTag: 885f6e66-c2b6-42c5-ba5d-310011b7e948
		summarizeBy: none
		sourceColumn: home_store_id

	column 'signup_date'
		dataType: dateTime
		formatString: d mmm yyyy
		lineageTag: a8e56e0c-20de-435d-a031-d750c40db9b4
		summarizeBy: none
		sourceColumn: signup_date

	column 'acquisition_channel'
		dataType: string
		lineageTag: 2a45c2ab-8cbf-4db0-b264-accc79ac1b1e
		summarizeBy: none
		sourceColumn: acquisition_channel

	column 'Cohort Month' =
			DATE ( YEAR ( Customers[signup_date] ), MONTH ( Customers[signup_date] ), 1 )
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 9b49bd26-df57-459a-8715-a10343dac043
		summarizeBy: none

	partition 'Customers' = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "customers.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"customer_id", type text}, {"home_store_id", type text}, {"signup_date", type date},
				        {"acquisition_channel", type text}}, "en-IN")
				in
				    Typed

	annotation PBI_ResultType = Table

