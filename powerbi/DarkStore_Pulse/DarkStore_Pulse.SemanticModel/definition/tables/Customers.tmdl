	column 'Cohort Month' = DATE ( YEAR ( Customers[signup_date] ), MONTH ( Customers[signup_date] ), 1 )
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 2227f45b-0c71-4854-a577-02d17f1eda85
