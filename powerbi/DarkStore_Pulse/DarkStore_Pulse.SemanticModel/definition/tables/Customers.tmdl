		sourceColumn: signup_date

		variation Variation
			isDefault
			relationship: a0828ee2-56eb-4510-9d08-8c7205838328
			defaultHierarchy: LocalDateTable_10d5fc1a-138f-4b88-b70f-2f85c20936bc.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column acquisition_channel
		dataType: string
		lineageTag: 8cc3b409-71a3-41cb-a0fa-b244f3486feb
