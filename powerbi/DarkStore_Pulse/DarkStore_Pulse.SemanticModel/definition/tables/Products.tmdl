table 'Products'
	lineageTag: 81f631d4-a392-41a7-9777-a4774c66e0a8

	column 'product_id'
		dataType: string
		isHidden
		lineageTag: 5fb8d16c-2720-497d-b2eb-d6899be578c7
		summarizeBy: none
		sourceColumn: product_id

	column 'category'
		dataType: string
		lineageTag: f4188f3f-8a14-4e62-a95b-4715c333e861
		summarizeBy: none
		sourceColumn: category

	column 'product_name'
		dataType: string
		lineageTag: eb2263dd-87c5-421e-ac24-a3c5c754108f
		summarizeBy: none
		sourceColumn: product_name

	column 'mrp'
		dataType: decimal
		formatString: ₹#,0.00
		lineageTag: 7d154385-52fb-443b-9954-6eb400257ad1
		summarizeBy: sum
		sourceColumn: mrp

	column 'unit_cost'
		dataType: decimal
		formatString: ₹#,0.00
		lineageTag: 5cec4eb5-edd9-4831-9ca3-5cfb04fc6d82
		summarizeBy: sum
		sourceColumn: unit_cost

	column 'shelf_life'
		dataType: string
		lineageTag: ce88cb2d-d4e8-4839-bc3e-058be0f3eab0
		summarizeBy: none
		sourceColumn: shelf_life

	column 'margin_pct'
		dataType: double
		formatString: 0.0%
		lineageTag: 3da9c2a9-0ed4-4f1a-bd4c-bf374eb93eff
		summarizeBy: sum
		sourceColumn: margin_pct

	partition 'Products' = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "products.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"product_id", type text}, {"category", type text}, {"product_name", type text},
				        {"mrp", Currency.Type}, {"unit_cost", Currency.Type}, {"shelf_life", type text}}, "en-IN"),
				    AddMargin = Table.AddColumn(Typed, "margin_pct", each ([mrp] - [unit_cost]) / [mrp], Percentage.Type)
				in
				    AddMargin

	annotation PBI_ResultType = Table

