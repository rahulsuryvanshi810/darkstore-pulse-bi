table Products
	lineageTag: b5fe58c6-db26-477b-b6e2-5f67c95a280c

	column product_id
		dataType: string
		isHidden
		lineageTag: 75a802a2-0bb2-4a9d-b12f-391121bfd6ac
		summarizeBy: none
		sourceColumn: product_id

	column category
		dataType: string
		lineageTag: 0fc29145-b717-4296-b686-c4d5ed457749
		summarizeBy: none
		sourceColumn: category

	column product_name
		dataType: string
		lineageTag: 431651ea-5902-4013-bb31-94e9ee8fe894
		summarizeBy: none
		sourceColumn: product_name

	column mrp
		dataType: decimal
		formatString: ₹#,0.00
		lineageTag: 85df6b10-e104-42ee-acd8-7c795fb8d283
		summarizeBy: sum
		sourceColumn: mrp

	column unit_cost
		dataType: decimal
		formatString: ₹#,0.00
		lineageTag: 061f253e-b65e-452a-99e4-69075dcca4fb
		summarizeBy: sum
		sourceColumn: unit_cost

	column shelf_life
		dataType: string
		lineageTag: 0ab103fc-6299-4ea1-acab-237c01b7d056
		summarizeBy: none
		sourceColumn: shelf_life

	column margin_pct
		dataType: double
		formatString: 0.0%
		lineageTag: 99f05add-83f7-4280-9ffa-60770880ff8c
		summarizeBy: sum
		sourceColumn: margin_pct

	partition Products = m
		mode: import
		source =
				let
				    Source  = Csv.Document(File.Contents(DataFolder & "products.csv"),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed   = Table.TransformColumnTypes(Headers, {
				        {"product_id", type text}, {"category", type text}, {"product_name", type text},
				        {"mrp", Currency.Type}, {"unit_cost", Currency.Type}, {"shelf_life", type text}}, "en-IN"),
				    AddMargin = Table.AddColumn(Typed, "margin_pct", each ([mrp] - [unit_cost]) / [mrp], Percentage.Type)
				in
				    AddMargin

	annotation PBI_ResultType = Table

